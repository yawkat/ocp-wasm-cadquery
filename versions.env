# Pinned inputs of the build. Sourced by scripts/*.sh and loaded into the
# GitHub Actions environment, so keep this to plain KEY=value lines.

# yeicor/OCP.wasm commit to build from. master has moved on to OCP 8.0, which
# CadQuery 2.8 cannot use, so this is pinned to the last OCP 7.9 commit.
# renovate: datasource=git-refs depName=yeicor/OCP.wasm packageName=https://github.com/yeicor/OCP.wasm currentValue=master
OCP_WASM_COMMIT=f292a6312ec648fd4eca2d8d8734708d9da1576c

# OCP version the upstream commit builds. Must match the OCP_src_stubs_Linux.zip
# URL in upstream's cadquery-ocp-novtk/CMakeLists.txt (scripts/prepare.sh checks).
OCP_VERSION=7.9.3.1

# CadQuery release whose OCP imports decide the keep list.
# renovate: datasource=pypi depName=cadquery
CADQUERY_VERSION=2.8.0

# Pyodide cross-build environment. Decides the Python version, the wheel's
# platform tag (ABI) and the emscripten version.
# renovate: datasource=github-releases depName=pyodide/pyodide
PYODIDE_XBUILDENV_VERSION=314.0.7
PYTHON_VERSION=3.14

# wasm-opt (binaryen release number), used by upstream's repair_wasm.py.
# renovate: datasource=github-releases depName=WebAssembly/binaryen
BINARYEN_VERSION=129
